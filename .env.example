# MotoGroup — örnek ortam değişkenleri (bkz. CLAUDE.md Bölüm 7)
# Gerçek .env dosyaları repoya GİRMEZ. Bunu kopyalayıp doldurun.

# --- Mobil (apps/mobile) — public, client bundle'a girer ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# --- Web (apps/web) — yukarıdakiler + server-only secret'lar ---
# UYARI: SUPABASE_SERVICE_ROLE_KEY ve PAYTR_* ASLA client'a sızmamalı.
# Sadece server / Edge Function tarafında kullanılır.
SUPABASE_SERVICE_ROLE_KEY=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
