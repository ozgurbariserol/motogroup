# React Native / Expo, pnpm'in sembolik-link node_modules düzeniyle uyumsuzdur.
# Hoisted düzen Metro'nun bağımlılıkları çözebilmesi için gereklidir.
node-linker=hoisted

# Expo / RN paketleri peer bağımlılıklarını gevşek bildirir; kurulumu engellememesi için.
auto-install-peers=true
strict-peer-dependencies=false
