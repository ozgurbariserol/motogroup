# apps/web — Next.js. NEXT_PUBLIC_* değişkenleri client bundle'a girer.
# UYARI (CLAUDE.md Bölüm 7): SUPABASE_SERVICE_ROLE_KEY ve PAYTR_* SERVER-ONLY'dir,
# NEXT_PUBLIC_ önekiyle ASLA tanımlanmaz (yoksa client'a sızar).

# --- Public (client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only ---
SUPABASE_SERVICE_ROLE_KEY=

# PayTR — yalnızca gerçek ödeme entegrasyonunda (Bölüm 8 adım 9). Mock akışta kullanılmaz.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
